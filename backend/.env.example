# ==============================================================================
# Farmy Backend Environment Configuration
# ==============================================================================

# Server
PORT=6767
NODE_ENV=development

# Database (MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/farmy
MONGOOSE_AUTO_INDEX=true
MONGO_MAX_POOL_SIZE=10
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=45000

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
# 32-byte key in hex format for AES-256-GCM Aadhaar encryption (generate with: openssl rand -hex 32)
IDENTITY_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# CORS (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# SMS Provider ('mock' | 'twilio' | 'twilio_verify' | 'fast2sms')
SMS_PROVIDER=mock

# Fast2SMS (required if SMS_PROVIDER=fast2sms)
FAST2SMS_API_KEY=

# Twilio (required if SMS_PROVIDER=twilio or twilio_verify)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
